    },
    "hook_kind": {
      "type": "enum:modded|subclass",
      "doc": "modded = 'modded class <dayz_class>' changes it everywhere; subclass = our own class extending it."
    },
    "file": {
      "type": "string",
      "doc": "Path under mod/RivalsDayZ/scripts."
    },
    "purpose": {
      "type": "string"
    },
