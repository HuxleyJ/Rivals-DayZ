<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the platform-independent parts of the launcher on Linux/CI: invite codes, PAA
       writer, Ogg Vorbis encoder, Wwise bank parsing, option parsing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RivalsDayZ.Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RivalsDayZ.Launcher/Network.cs" />
    <Compile Include="../RivalsDayZ.Launcher/Paa.cs" />
    <Compile Include="../RivalsDayZ.Launcher/Audio.cs" />
    <Compile Include="../RivalsDayZ.Launcher/Log.cs" />
    <Compile Include="../RivalsDayZ.Launcher/Generated.cs" />
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>
</Project>
